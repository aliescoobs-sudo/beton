# Copy to .env.local and fill in. Never commit real values.
# Generate secrets with: openssl rand -base64 32

NODE_ENV=development

# One PostgreSQL role per purpose (see SPEC-platform-security §4)
DATABASE_URL_APP=postgres://belgobeton_app:CHANGE_ME@localhost:5432/belgobeton
DATABASE_URL_MIGRATOR=postgres://belgobeton_migrator:CHANGE_ME@localhost:5432/belgobeton
DATABASE_URL_AUTH=postgres://belgobeton_auth:CHANGE_ME@localhost:5432/belgobeton
DATABASE_URL_SYSTEM=postgres://belgobeton_system:CHANGE_ME@localhost:5432/belgobeton

# At least 32 characters
AUTH_SECRET=
# 32 bytes, base64
FIELD_ENCRYPTION_KEY=
# age public key (age-keygen); the private key stays off this host
BACKUP_AGE_RECIPIENT=

# Pilot flags ("true" / "false")
SIMULATION_ENABLED=false
REAL_DATA=false
