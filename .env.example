# Copy to .env.local (app) and fill in. Never commit real values.
# Ops-only secrets (marked [OPS] below) go in a separate .env.ops: Next.js never loads that file, so the running app
# never holds the superuser or the backup role. Scripts (db:up, db:bootstrap, backup, restore-test) read both files.
# Generate secrets with: openssl rand -base64 32

NODE_ENV=development

# [OPS] Local docker-compose superuser, used only by db:up and db:bootstrap (never by the app)
POSTGRES_SUPERUSER_PASSWORD=

# One PostgreSQL role per purpose (see SPEC-platform-security §4)
DATABASE_URL_APP=postgres://belgobeton_app:CHANGE_ME@localhost:5432/belgobeton
DATABASE_URL_MIGRATOR=postgres://belgobeton_migrator:CHANGE_ME@localhost:5432/belgobeton
DATABASE_URL_AUTH=postgres://belgobeton_auth:CHANGE_ME@localhost:5432/belgobeton
DATABASE_URL_SYSTEM=postgres://belgobeton_system:CHANGE_ME@localhost:5432/belgobeton
# [OPS] Backup job only (pnpm backup): read-only role that bypasses RLS so pg_dump sees every row.
# Never set it in .env.local or the app runtime environment (security checklist item backup_credentials_isolated).
DATABASE_URL_BACKUP=postgres://belgobeton_backup:CHANGE_ME@localhost:5432/belgobeton

# At least 32 characters
AUTH_SECRET=
# Keyrings: <id>:<32-byte key, base64>[,<retired id>:<key>…], current key first. Rotate with `pnpm crypto:rotate`.
# e.g. FIELD_ENCRYPTION_KEYS=k1:$(openssl rand -base64 32)
FIELD_ENCRYPTION_KEYS=
# Dedicated keyring for 2FA recovery codes. Never stored in the database.
RECOVERY_CODES_KEYS=
# Keyed hash of login identifiers and IPs (32 bytes, base64)
LOOKUP_HMAC_KEY=

# Origin the app is served from (auth origin checks, cookies)
APP_BASE_URL=http://localhost:3000
# age public key (age-keygen); the private key stays off this host
BACKUP_AGE_RECIPIENT=
# [OPS] Restore test only: path to the age private key (never in the repo, never on the app host in production)
BACKUP_AGE_IDENTITY_FILE=

# Pilot flags ("true" / "false")
SIMULATION_ENABLED=false
REAL_DATA=false
# Reverse proxies in front of the app that append to X-Forwarded-For (0 = ignore the header; per-IP lockout off)
TRUSTED_PROXY_HOPS=0
# "true" only for throwaway test servers: no cron scheduler
JOB_SCHEDULER_DISABLED=false
