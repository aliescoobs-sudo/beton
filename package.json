{
  "name": "belgobeton",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "ci:local": "eslint . && prettier --check . && tsc --noEmit && vitest run && node --import ./scripts/register-ts-paths.mjs scripts/audit-verify.ts && next build && playwright test",
    "db:up": "docker compose --env-file .env.ops up -d --wait db",
    "db:ps": "docker compose --env-file .env.ops ps",
    "db:down": "docker compose --env-file .env.ops stop db",
    "db:bootstrap": "node --import ./scripts/register-ts-paths.mjs scripts/db-bootstrap.ts",
    "db:seed": "node --import ./scripts/register-ts-paths.mjs scripts/seed-pilot.ts",
    "db:scenario": "node --import ./scripts/register-ts-paths.mjs scripts/seed-scenario.ts",
    "import:excel": "node --import ./scripts/register-ts-paths.mjs scripts/import-excel.ts",
    "assistant:purge": "node --import ./scripts/register-ts-paths.mjs scripts/assistant-purge.ts",
    "db:migrate": "node --import ./scripts/register-ts-paths.mjs scripts/db-migrate.ts",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "audit:verify": "node --import ./scripts/register-ts-paths.mjs scripts/audit-verify.ts",
    "user:create-owner": "node --import ./scripts/register-ts-paths.mjs scripts/create-owner.ts",
    "test:e2e": "playwright test",
    "crypto:rotate": "node --import ./scripts/register-ts-paths.mjs scripts/crypto-rotate.ts",
    "backup": "node --import ./scripts/register-ts-paths.mjs scripts/backup.ts",
    "backup:restore-test": "node --import ./scripts/register-ts-paths.mjs scripts/restore-test.ts",
    "user:reset-owner-2fa": "node --import ./scripts/register-ts-paths.mjs scripts/reset-owner-2fa.ts"
  },
  "dependencies": {
    "@better-auth/utils": "0.4.2",
    "@node-rs/argon2": "2.2.1",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.3",
    "next": "16.3.8",
    "next-intl": "4.14.9",
    "pg": "8.23.1",
    "pg-boss": "^12.38.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "uqr": "0.1.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-plugin-boundaries": "7.2.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
