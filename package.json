{
  "name": "belgobeton",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ci:local": "eslint . && prettier --check . && tsc --noEmit && vitest run && node scripts/audit-verify.ts && next build",
    "db:up": "docker compose --env-file .env.local up -d --wait db",
    "db:down": "docker compose --env-file .env.local stop db",
    "db:bootstrap": "node scripts/db-bootstrap.ts",
    "db:migrate": "node scripts/db-migrate.ts",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "audit:verify": "node scripts/audit-verify.ts",
    "user:create-owner": "node --import ./scripts/register-ts-paths.mjs scripts/create-owner.ts"
  },
  "dependencies": {
    "@better-auth/utils": "0.4.2",
    "@node-rs/argon2": "2.2.1",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.3",
    "next": "16.3.8",
    "next-intl": "4.14.9",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-plugin-boundaries": "7.2.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
